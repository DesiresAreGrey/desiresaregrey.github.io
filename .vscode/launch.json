{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "TypeScript Watch",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run watch-ts",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Zensical Serve",
      "type": "node-terminal",
      "request": "launch",
      "command": "py -m zensical serve",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Tailscale Serve",
      "type": "node-terminal",
      "request": "launch",
      "command": "tailscale serve --tcp=8000 tcp://127.0.0.1:8000",
      "cwd": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "Zensical/TS",
      "configurations": ["TypeScript Watch", "Zensical Serve"],
      "stopAll": true
    },
    {
      "name": "Tailscale + Zensical/TS",
      "configurations": ["TypeScript Watch", "Zensical Serve", "Tailscale Serve"],
      "stopAll": true
    }
  ]
}