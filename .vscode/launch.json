{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MkDocs Serve",
      "type": "node-terminal",
      "request": "launch",
      "command": "powershell -ExecutionPolicy Bypass -File server.ps1",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "ngrok Tunnel",
      "type": "node-terminal",
      "request": "launch",
      "command": "ngrok http 8000",
      "cwd": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "ngrok + MkDocs Serve",
      "configurations": ["MkDocs Serve", "ngrok Tunnel"],
      "stopAll": true
    }
  ]
}