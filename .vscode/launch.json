{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "TypeScript Watch",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run watch-ts",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Zensical Serve",
      "type": "node-terminal",
      "request": "launch",
      "command": "py -m zensical serve",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "ngrok Tunnel",
      "type": "node-terminal",
      "request": "launch",
      "command": "ngrok http 8000",
      "cwd": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "Zensical/TS",
      "configurations": ["TypeScript Watch", "Zensical Serve"],
      "stopAll": true
    },
    {
      "name": "ngrok + Zensical/TS",
      "configurations": ["TypeScript Watch", "Zensical Serve", "ngrok Tunnel"],
      "stopAll": true
    }
  ]
}