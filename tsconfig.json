{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",

    "outDir": "docs/js",
    "rootDir": "src",
    
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "removeComments": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "inlineSources": true,
    "incremental": true,
    "tsBuildInfoFile": ".cache/tsconfig.tsbuildinfo",
  },

  "include": ["src/**/*"],
  "exclude": ["node_modules", "docs"]
}
